{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "5175"
      ],
      "cwd": "frontend",
      "port": 5175
    },
    {
      "name": "frontend-cloud",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "set VITE_APP_MODE=cloud&& npm run dev -- --port 5176 --strictPort"
      ],
      "cwd": "frontend",
      "port": 5176
    },
    {
      "name": "autotrade-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "5177",
        "--strictPort"
      ],
      "cwd": "autotrade/web",
      "port": 5177
    }
  ]
}
