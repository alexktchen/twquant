# 複製為 .env（已 gitignore）後填入實際值。秘密只放這裡（CLAUDE.md 黃金規則 9）。
#   cp .env.example .env

# ── 資料來源 / 券商秘密（SPEC-000）─────────────────────────────
FINMIND_TOKEN=
SHIOAJI_API_KEY=
SHIOAJI_SECRET=
# 資料湖根目錄覆寫（預設走 configs/system.yaml 的 data_dir）
# TWQUANT_DATA_DIR=
# docker-compose 掛進容器的主機資料湖路徑（worktree 內無 data/ 時，指向主 repo 的真實湖）
TWQUANT_DATA_HOST=D:/project/twquant/data

# ── 供應層 PostgreSQL（SPEC-009）─────────────────────────────
# 本機 CLI（uv run）連 docker 對外埠 5433：
TWQUANT_PG_DSN=postgresql://twquant:twquant@localhost:5433/twquant
# docker-compose 的 app/scheduler/api 走內網服務名 pg:5432：
TWQUANT_PG_DSN_DOCKER=postgresql://twquant:twquant@pg:5432/twquant
# postgres 容器初始化帳密（本機開發預設；正式改此並重建 pgdata volume）：
POSTGRES_USER=twquant
POSTGRES_PASSWORD=twquant
POSTGRES_DB=twquant

# ── 洞悉層 LLM（SPEC-008 / D-185）──────────────────────────────
# Anthropic（advisor／explainer 路由）；沒設就離線降級
ANTHROPIC_API_KEY=
# Cloudflare Workers AI（candidate_analysis／daily_brief 路由，免費額度 10,000 Neurons／日）
# 帳號 ID：後台 Workers & Pages 右側欄；token：自訂 token，權限 Account › Workers AI › Read
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=
